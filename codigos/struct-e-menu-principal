#include <stdio.h>
#include <string.h>

#define MAX 10

// Struct
typedef struct Produto {
    int codigo;
    char nome[50];
    float preco;
    int quantidade;
    int ativo;
} Produto;

//Inserir Produto
int inserirProduto(Produto produtos[], int total){
    if (total >= MAX){
        printf("Limite de produtos atingidos!\n");
        return total;
    }

    printf("Digite o codigo: ");
    scanf("%d", &produtos[total].codigo);

    printf("Digite o nome: ");
    scanf(" %[^\n", &produtos[total].nome);

    printf("Digite o preco: ");
    scanf("%f", &produtos[total].preco);

    printf("Digite a quantidade: ");
    scanf("%d", &produtos[total].quantidade);

    produtos[total].ativo = 1;

    printf("Produto cadastrado com sucesso!\n");

    return total + 1;
}

int main(){
    Produto produtos[MAX];
    int total = 0;
    int opcao;

    do {
        printf("\n--- MENU ---\n");
        printf("1 - Inserir Produto\n");
        printf("2 - Listar Produto\n");
        printf("3 - Editar Produto\n");
        printf("4 - Excluir Produto\n");
        printf("5 - Pesquisar Produto\n");
        printf("6 - Resumo\n");
        printf("0 - Sair\n");
        printf("Escolha: ");
        scanf("%d", &opcao);

        switch(opcao) {
            case 1:
                printf("Inserindo Produto: ");
            break;

            case 2:
                printf("Listando Produto: ");
            break;

            case 3:
                printf("Editando Produto: ");
            break;

            case 4:
                printf("Excluindo Produto: ");
            break;

            case 5:
                printf("Pesquisando Produto:");
            break;

            case 6:
                printf("Resumindo:");
            break;

            case 0:
                printf("Encerrando");
            break;
        }

    } while (opcao != 0);




}
