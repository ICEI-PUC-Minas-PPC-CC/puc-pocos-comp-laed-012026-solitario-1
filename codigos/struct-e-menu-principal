#include <stdio.h>
#include <string.h>

#define MAX 10

// Struct
typedef struct Produto {
    int codigo;
    char nome[50];
    float preco;
    int quantidade;
    int ativo;
} Produto;

//Inserir Produto
int inserirProduto(Produto produtos[], int total){
    if (total >= MAX){
        printf("Limite de produtos atingidos!\n");
        return total;
    }

    printf("Digite o codigo: ");
    scanf("%d", &produtos[total].codigo);

    printf("Digite o nome: ");
    scanf(" %[^\n]", &produtos[total].nome);

    printf("Digite o preco: ");
    scanf("%f", &produtos[total].preco);

    printf("Digite a quantidade: ");
    scanf("%d", &produtos[total].quantidade);

    produtos[total].ativo = 1;

    printf("Produto cadastrado com sucesso!\n");

    return total + 1;
}


//Listar Produtos
void listarProdutos(Produto produtos[],int total){
    int i;
    int encontrou = 0;

    for(i = 0; i < total; i++){
        if(produtos[i].ativo == 1){
            printf("\nCodigo: %d\n",produtos[i].codigo);
            printf("Nome:  %s\n", produtos[i].nome);
            printf("Preco: %2f\n", produtos[i].preco);
            printf("Quantidade: %d\n", produtos[i].quantidade);

            encontrou = 1;
        }
    }

    if (encontrou == 0){
        printf("Nenhum produto cadastrado.\n");
    }
}


//Editar Produto
void editarProduto(Produto produtos[], int total){
    int codigo, i;

    printf("Digite o codigo do produto: ");
    scanf("%d", &codigo);

    for(i = 0; i < total; i++){
        if(produtos[i].codigo == codigo && produtos[i].ativo == 1){

            printf("Novo nome: ");
            scanf(" %[^\n]", produtos[i].nome);

            printf("Novo preco: ");
            scanf("%f", &produtos[i].preco);

            printf("Nova quantidade: ");
            scanf("%d", &produtos[i].quantidade);

            printf("Produto editado com sucesso\n");
        return;
        }
    }

    printf("Produto nao encontrado.\n");
}


//Pesquisar Produto
void pesquisarProduto(Produto produtos[], int total){
    int codigo, i;

    printf("Digite o codigo do produto:");
    scanf("%d", &codigo);

    for(i = 0; i < total; i++){
        if(produtos[i].codigo == codigo && produtos[i].ativo == 1){

            printf("\nProduto encontrado:\n");
            printf("Nome: %s\n", produtos[i].nome);
            printf("Preco: %.2f\n", produtos[i].preco);
            printf("Quantidade: %d\n", produtos[i].quantidade);

        return;
        }
    }

    printf("Produto não encontrado.\n");

    }

int main(){
    Produto produtos[MAX];
    int total = 0;
    int opcao;

    do {
        printf("\n--- MENU ---\n");
        printf("1 - Inserir Produto\n");
        printf("2 - Listar Produto\n");
        printf("3 - Editar Produto\n");
        printf("4 - Excluir Produto\n");
        printf("5 - Pesquisar Produto\n");
        printf("6 - Resumo\n");
        printf("0 - Sair\n");
        printf("Escolha: ");
        scanf("%d", &opcao);

        switch(opcao) {
            case 1:
                total =
                inserirProduto(produtos,total);
            break;

            case 2:
                listarProdutos(produtos,total);
            break;

            case 3:
                editarProduto(produtos,total);
            break;

            case 4:
                printf("Excluindo Produto: ");
            break;

            case 5:
                pesquisarProduto(produtos,total);
            break;

            case 6:
                printf("Resumindo:");
            break;

            case 0:
                printf("Encerrando");
            break;
        }

    } while (opcao != 0);

    return 0;

}

